#!/usr/bin/env bash
# 缘之空 高清重制 —— 一键启动器（供桌面双击或终端直接运行）
# 作用：定位本脚本所在仓库根目录并切过去，再用绝对路径启动 krkrsdl2，
#       把 data 目录的绝对路径作为【最后一个】参数传给引擎；
#       用户附加的参数原样透传（放在 data 之前）。
# 注意：本脚本依赖仓库留在原位（二进制与 data 都在仓库里）。

set -u

# --- 解析脚本自身真实路径（跟随符号链接），据此得到仓库根目录 ---
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
	dir="$(cd -P "$(dirname "$src")" && pwd)"
	src="$(readlink "$src")"
	[[ "$src" != /* ]] && src="$dir/$src"
done
repo_root="$(cd -P "$(dirname "$src")" && pwd)"

exe="$repo_root/build/dev/linux-sdl2/krkrsdl2"
data="$repo_root/data"
log=/tmp/yosuga-launch.log

# 双击启动时可能没有会话环境变量，仅在缺失时补上默认值（niri/Wayland 会话）
: "${DISPLAY:=:0}"
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export DISPLAY XDG_RUNTIME_DIR

cd "$repo_root" || exit 1

# --- 二进制不存在时给出明确提示，绝不静默失败 ---
if [ ! -x "$exe" ]; then
	printf '找不到游戏可执行文件：%s\n请先在仓库根目录运行：./project.sh run linux-sdl2\n' "$exe" >&2
	printf '[%s] 启动失败：可执行文件不存在 %s\n' "$(date '+%F %T')" "$exe" >>"$log"
	exit 1
fi

if [ -t 1 ]; then
	# 终端里运行：输出同时回显并追加进日志
	"$exe" "$@" "$data" 2>&1 | tee -a "$log"
	exit "${PIPESTATUS[0]}"
else
	# 双击运行：没有终端，输出全部追加进日志便于排查
	exec >>"$log" 2>&1
	printf '[%s] 启动：%s (cwd=%s)\n' "$(date '+%F %T')" "$exe" "$PWD"
	"$exe" "$@" "$data"
fi
